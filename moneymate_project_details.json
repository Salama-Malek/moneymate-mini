{
  "projectName": "MoneyMate",
  "description": "Offline React Native app for tracking money lent or borrowed with multi-currency support, notifications, and archiving.",
  "features": {
    "transactions": ["Add, edit, delete, archive, restore transactions", "Type (Lend/Borrow), person, amount, currency, date, dueDate, status, notes, optional recurring"],
    "notifications": ["Local push notifications for upcoming due dates", "Configurable reminder timing", "Stop notifications for archived or deleted transactions"],
    "multiCurrency": ["Store currency per transaction", "Optional total in default currency"],
    "analyticsDashboard": ["Totals: lent, borrowed, outstanding, overdue", "Optional charts"],
    "searchFilter": ["Search by person, amount, notes", "Filter by type, status, currency"],
