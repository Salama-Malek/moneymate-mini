    "optional": ["Recurring transactions", "PIN/biometric login", "Calendar view", "Dark/light theme"]
  },
  "dataModel": {
    "id": "uuid",
    "type": "lend | borrow",
    "person": "string",
    "amount": "number",
    "currency": "string",
    "date": "string",
    "dueDate": "string",
    "status": "pending | paid",
    "archived": "boolean",
    "notes": "string (optional)",
    "recurring": "{frequency: string, endDate: string} | null"
  },
  "screens": ["Home/Dashboard", "Transaction List (Active/Archived)", "Add/Edit Transaction", "Archived Transactions", "Notification Settings", "Analytics/Insights", "Settings"],
  "techStack": ["React Native + TypeScript", "AsyncStorage/SQLite/Realm", "Redux/Zustand", "date-fns/moment", "Optional Currency API"],
  "installation": ["npm install or yarn install", "npx react-native run-android", "npx react-native run-ios"],
  "usageFlow": ["View active transactions", "Add transaction", "Notifications scheduled", "Mark as paid and archive", "Restore archived if needed", "Search/filter/view summary"],
  "offlineFirst": true
}